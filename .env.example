# Copy this file to `.env` and fill in your Supabase project's values.
# Never commit the real `.env` file — it is gitignored.
#
# Find these in Supabase Dashboard > Project Settings > API.
# SUPABASE_ANON_KEY is the public "anon" / "publishable" key — safe to ship in
# a client app as long as Row Level Security is enabled on every table.
# NEVER put the service_role key here or anywhere in the Flutter app.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
